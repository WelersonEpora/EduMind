# Copie para .env (na raiz do projeto) e preencha. O .env não vai para o git.

# App
NODE_ENV=development
APP_PORT=3000

# Pasta dos arquivos enviados (PDFs dos editais, normas baixadas), relativa à raiz do projeto.
DATA_DIR=data

# PostgreSQL. Em desenvolvimento, o Postgres compartilhado desta máquina (C:\Source\infra), com usuário e
# databases próprios: edumind e edumind_test (este só para os testes, que apagam os dados a cada caso).
# A senha está em C:\Source\infra\apps.env (POSTGRES_EDUMIND_PASSWORD).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=edumind
POSTGRES_DATABASE_TEST=edumind_test
POSTGRES_USER=edumind
POSTGRES_PASSWORD=

# IA (Gemini). Opcional: sem chave, upload, texto por página e revisão continuam funcionando; só a
# extração com IA (etapa 1b) falha quando chamada. Mesmo padrão do FinMind e do AgroMind:
# a chave gratuita é tentada primeiro e a paga só entra quando a gratuita esgota a cota ou falha.
# Exceção: a extração do edital usa só a paga (a gratuita, sob "alta demanda", travava a chamada).
GEMINI_API_KEY_FREE=
GEMINI_API_KEY=
# Alias da Google que aponta sempre para o Flash mais recente.
GEMINI_MODEL=gemini-flash-latest
# Espera máxima por chamada (inclui as repetições num 5xx). A árvore do conteúdo do TJSP leva de 180 a 220 s.
GEMINI_TIMEOUT_MS=420000
